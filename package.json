{
  "name": "wild-sage-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run db:migrate:core && npm run db:migrate:wild-sage && node scripts/publish-weekenders.js && node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "db:migrate:core": "node scripts/migrate-core.js",
    "db:migrate:wild-sage": "node scripts/migrate-wild-sage-data.js",
    "test:totes:integration": "node --test qa/tote-*.integration.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
